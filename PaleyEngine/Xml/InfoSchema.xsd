<?xml version="1.0" encoding="utf-8"?>
<xs:schema id="InfoSchema" xmlns:xs="http://www.w3.org/2001/XMLSchema">

	<!-- Non empty string -->
	<xs:simpleType name="nonEmptyString">
		<xs:restriction base="xs:string">
			<xs:minLength value="1" />
		</xs:restriction>
	</xs:simpleType>

	<!-- Main -->
	<xs:element name="Info">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="BitmapLength" type="xs:positiveInteger" minOccurs="1" maxOccurs="1" />
				<xs:element name="BitmapVersion" type="nonEmptyString" minOccurs="1" maxOccurs="1" />
				<xs:element name="DatabaseDescription" type="nonEmptyString" minOccurs="1" maxOccurs="1" />
				<xs:element name="DatabaseVersion" type="nonEmptyString" minOccurs="1" maxOccurs="1" />
				<xs:element name="DataFile" type="nonEmptyString" minOccurs="1" maxOccurs="1" />
				<xs:element name="FileLength" type="xs:positiveInteger" minOccurs="1" maxOccurs="1" />
				<xs:element name="FileSplit" type="xs:positiveInteger" minOccurs="1" maxOccurs="1" />
				<xs:element name="MaxPermUrn" type="xs:positiveInteger" minOccurs="1" maxOccurs="1" />
				<xs:element name="MaxTempUrn" type="xs:positiveInteger" minOccurs="1" maxOccurs="1" />
				<xs:element name="PermTemp" type="nonEmptyString" minOccurs="1" maxOccurs="1" />
				<xs:element name="TempPerm" type="nonEmptyString" minOccurs="1" maxOccurs="1" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>

